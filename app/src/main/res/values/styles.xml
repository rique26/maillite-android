<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.MailLite" parent="android:Widget" />
    
    <!-- ===================== Shape ===================== -->
    <style name="ShapeAppearance.MailLite.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_medium</item>
    </style>

    <!-- ===================== Botões ===================== -->
    <style name="Widget.MailLite.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MailLite.Corner.Medium</item>
    </style>

    <style name="Widget.MailLite.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MailLite.Corner.Medium</item>
    </style>

    <!-- ===================== Campos de texto ===================== -->
    <style name="Widget.MailLite.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_medium</item>
    </style>

    <!-- ===================== Cards (dropdown de sugestões) ===================== -->
    <style name="Widget.MailLite.CardView.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.MailLite.Corner.Medium</item>
        <item name="cardElevation">@dimen/elevation_dropdown</item>
    </style>

    <!-- ===================== Avatar (badge de iniciais) ===================== -->
    <style name="Widget.MailLite.Avatar">
        <item name="android:layout_width">@dimen/avatar_size_default</item>
        <item name="android:layout_height">@dimen/avatar_size_default</item>
        <item name="android:background">@drawable/shape_avatar_background</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/avatar_text_size_default</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.MailLite.Avatar.Small">
        <item name="android:layout_width">@dimen/avatar_size_small</item>
        <item name="android:layout_height">@dimen/avatar_size_small</item>
        <item name="android:textSize">@dimen/avatar_text_size_small</item>
    </style>

</resources>
